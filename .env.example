PORT=8085
# Cache TTL in seconds (default 86400 = 1 day)
CACHE_TTL=86400
JELLYFIN_BASE_URL=YOUR_JELLYFIN_URL
JELLYFIN_API_KEY=YOUR_JELLYFIN_API_KEY
# Optional: set a custom Puppeteer executable path if you provide system Chromium
#PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Debug: set to true to persist debug screenshots inside the container `data/` folder
# Useful for troubleshooting but should remain false in normal operation.
DEBUG_SCREENSHOTS=false

# Update Jellyfin metadata settings
# When `true` the updater will not apply changes and will only show the payload.
# Set to `false` to apply updates to Jellyfin.
UPDATE_JELLYFIN_DRY_RUN=true

# When `true` also set the optional CriticRating field when available.
UPDATE_JELLYFIN_SET_CRITIC=false

# When `true` skip fetching existing metadata and force updates.
UPDATE_JELLYFIN_FORCE=false

# Page size used when iterating movies (default 50)
UPDATE_JELLYFIN_PAGE_SIZE=50

# New sync script variables (scripts/sync-jellyfin.js)
# Control the sync behavior when using the `sync-jellyfin` script.
# Dry-run mode (true by default)
SYNC_JELLYFIN_DRY_RUN=true
# Maximum number of items to process (useful for testing)
SYNC_JELLYFIN_LIMIT=
# Number of concurrent tasks per batch (default 5)
SYNC_JELLYFIN_BATCH_SIZE=5
# Milliseconds to wait between batches (default 500)
SYNC_JELLYFIN_DELAY_MS=500
# Number of retries for network/scrape/update operations
SYNC_JELLYFIN_RETRIES=3
# Base retry delay in milliseconds (exponential backoff)
SYNC_JELLYFIN_RETRY_DELAY=1000
# When true, also set CriticRating when available
SYNC_JELLYFIN_SET_CRITIC=false
# When true, force updates even if metadata appears present
SYNC_JELLYFIN_FORCE=false
# Page size used when iterating items (default 100)
SYNC_JELLYFIN_PAGE_SIZE=100
# Comma-separated include types for iteration: Movie,Series,Episode
SYNC_JELLYFIN_INCLUDE_ITEM_TYPES=Movie

# Poster badge rendering (works for web, TV and mobile clients because poster is replaced server-side)
# Enable poster processing and upload back to Jellyfin.
ENABLE_POSTER_BADGES=false
# Badge position: top-right, top-left, bottom-right, bottom-left
POSTER_BADGE_POSITION=top-right
# Badge width ratio relative to poster width (recommended 0.12 - 0.35)
POSTER_BADGE_SIZE=0.2

# Incremental cache updater tuning
# - `CACHE_TTL` (seconds): canonical TTL for the in-memory cache (e.g. 86400 = 1 day).
# - `RECENT_TTL_DAYS`: TTL (in days) applied to recent releases (refreshed more often).
# - `RECENT_YEARS`: Number of years that count as "recent" for the updater.
#
# Implementation notes:
# - The scheduler / `update-cache` uses day-based TTL logic (`RECENT_TTL_DAYS`,
#   `RECENT_YEARS`) to decide when DB entries are stale.
# - The API uses `CACHE_TTL` (seconds) but entries are set with per-entry TTLs
#   derived from the movie year so recent movies are refreshed more often.
RECENT_TTL_DAYS=7
RECENT_YEARS=2
# Milliseconds to wait between individual FilmAffinity requests (scraping).
# Increase to lower scraping load and reduce rate-limit risk.
REQUEST_DELAY_MS=5000
 
# Path to SQLite DB file used for persistent ratings storage
# Relative to project root, e.g. `data/ratings.db`
DB_PATH=data/ratings.db
